# 실제 값은 .env에만 넣고 커밋하지 않는다.
KAKAO_REST_API_KEY=
INTERNAL_API_KEY=
DATABASE_URL=sqlite:///./sai_ai.db
# mock(기본): 카카오를 부르지 않음 / real: 실제 카카오 호출
KAKAO_CLIENT=mock
# real일 때 서버 프로세스당 하루 카카오 호출 상한 (무료 한도 보호)
KAKAO_DAILY_LIMIT=300
# Swagger 문서 공개 여부 (운영 false 권장)
DOCS_ENABLED=true
# 장소 가져오기(scripts/import_places.py)의 주소→좌표 변환용 공공 API 키 (VWorld)
VWORLD_API_KEY=
# 장소 가져오기 좌표 찾기용 소상공인 상가(상권)정보 API (data.go.kr)
SDSC_API_URL=https://apis.data.go.kr/B553077/api/open/sdsc2
SDSC_API_KEY=
